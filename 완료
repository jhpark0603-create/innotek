function data = fillInvalidData(data, variableDescription)
% NaN 및 Inf 값을 선형 보간합니다.

    data = data(:);

    data(~isfinite(data)) = NaN;


    if all(isnan(data))

        error( ...
            '%s 데이터가 모두 NaN 또는 Inf입니다.', ...
            variableDescription);
    end


    data = fillmissing( ...
        data, ...
        'linear', ...
        'EndValues', 'nearest');
end


function outputSignal = interpolateSignal( ...
    originalTime, ...
    originalSignal, ...
    newTime)
% 원본 신호를 균일 시간축으로 선형 보간합니다.

    outputSignal = interp1( ...
        originalTime, ...
        originalSignal, ...
        newTime, ...
        'linear');
end


function [frequency_Hz, amplitude, fftLength] = singleSidedFFT( ...
    signal, ...
    samplingFrequency_Hz, ...
    useHannWindow, ...
    useZeroPadding)
% 단측 FFT peak 진폭 스펙트럼을 계산합니다.
%
% 처리 과정:
%   1. 평균 및 선형 추세 제거
%   2. Hann window 적용
%   3. Coherent gain 보정
%   4. 단측 peak 진폭 계산

    signal = signal(:);

    numberOfSamples = numel(signal);


    if numberOfSamples < 4

        error('FFT 계산을 위한 데이터 개수가 너무 적습니다.');
    end


    signal = detrend(signal, 'linear');


    if useHannWindow

        sampleIndex = (0:numberOfSamples-1).';


        window = ...
            0.5 - ...
            0.5*cos( ...
            2*pi*sampleIndex / numberOfSamples);

    else

        window = ones(numberOfSamples, 1);
    end


    windowedSignal = signal .* window;


    if useZeroPadding

        fftLength = ...
            2^nextpow2(numberOfSamples);

    else

        fftLength = ...
            numberOfSamples;
    end


    fftResult = fft( ...
        windowedSignal, ...
        fftLength);


    numberOfSingleSidedPoints = ...
        floor(fftLength / 2) + 1;


    amplitude = ...
        2 * ...
        abs(fftResult(1:numberOfSingleSidedPoints)) / ...
        sum(window);


    amplitude(1) = amplitude(1) / 2;


    if rem(fftLength, 2) == 0

        amplitude(end) = amplitude(end) / 2;
    end


    frequency_Hz = ...
        (0:numberOfSingleSidedPoints-1).' * ...
        samplingFrequency_Hz / fftLength;
end


function [peakFrequency_Hz, peakAmplitude] = ...
    findPeakNearFrequency( ...
    frequency_Hz, ...
    amplitude, ...
    expectedFrequency_Hz, ...
    searchHalfWidth_Hz)
% 예상 회전 고조파 주파수 주변에서 최대 FFT 진폭을 검색합니다.

    if ~isfinite(expectedFrequency_Hz) || ...
            expectedFrequency_Hz < 0

        peakFrequency_Hz = NaN;
        peakAmplitude = NaN;

        return;
    end


    searchMask = ...
        frequency_Hz >= ...
        max(0, expectedFrequency_Hz - searchHalfWidth_Hz) & ...
        frequency_Hz <= ...
        expectedFrequency_Hz + searchHalfWidth_Hz;


    if ~any(searchMask)

        peakFrequency_Hz = NaN;
        peakAmplitude = NaN;

        return;
    end


    searchFrequency_Hz = ...
        frequency_Hz(searchMask);


    searchAmplitude = ...
        amplitude(searchMask);


    [peakAmplitude, localPeakIndex] = ...
        max(searchAmplitude);


    peakFrequency_Hz = ...
        searchFrequency_Hz(localPeakIndex);
end


function candidateTable = findResonanceCandidates( ...
    summaryTable, ...
    harmonicOrders, ...
    minimumAccelerationAmplification, ...
    minimumForceAmplification, ...
    strongAccelerationAmplification)
% RPM별 고조파 진폭의 국부 증폭을 이용하여 공진 후보를 검출합니다.
%
% 자동 판정에는 최소 3개 RPM이 필요합니다.
%
% 첫 번째 RPM과 마지막 RPM은 앞뒤 데이터가 모두 존재하지 않으므로
% 자동 판정 대상에서 제외합니다.
%
% 공진 후보 조건:
%
% 조건 A:
%   가속도 국부 증폭비 >= strongAccelerationAmplification
%
% 조건 B:
%   가속도 국부 증폭비 >= minimumAccelerationAmplification
%   전역 XY 합산반력 증폭비 >= minimumForceAmplification

    numberOfRPMPoints = height(summaryTable);


    if numberOfRPMPoints < 3

        candidateTable = createEmptyCandidateTable();

        return;
    end


    candidateSheet = strings(0, 1);
    candidateRPM = zeros(0, 1);
    candidateOrder = zeros(0, 1);
    candidateFrequency = zeros(0, 1);

    candidateAccelerationAmplitude = zeros(0, 1);
    candidateForceAmplitude = zeros(0, 1);

    candidateAccelerationRatio = zeros(0, 1);
    candidateForceRatio = zeros(0, 1);

    candidateReason = strings(0, 1);


    rpmValues = summaryTable.TargetRPM;


    for iOrder = 1:numel(harmonicOrders)

        currentOrder = harmonicOrders(iOrder);


        accelerationVariable = sprintf( ...
            'AccelerationXY_%dX_Amplitude_m_s2', ...
            currentOrder);


        accelerationFrequencyVariable = sprintf( ...
            'AccelerationXY_%dX_PeakFrequency_Hz', ...
            currentOrder);


        forceVariable = sprintf( ...
            'CombinedGlobalXYForce_%dX_Amplitude_N', ...
            currentOrder);


        requiredVariables = { ...
            accelerationVariable, ...
            accelerationFrequencyVariable, ...
            forceVariable};


        if ~all(ismember( ...
                requiredVariables, ...
                summaryTable.Properties.VariableNames))

            continue;
        end


        accelerationAmplitude = ...
            summaryTable.(accelerationVariable);


        accelerationPeakFrequency = ...
            summaryTable.(accelerationFrequencyVariable);


        forceAmplitude = ...
            summaryTable.(forceVariable);


        for iRPM = 2:numberOfRPMPoints-1

            relevantValues = [ ...
                accelerationAmplitude(iRPM-1:iRPM+1); ...
                forceAmplitude(iRPM-1:iRPM+1)];


            if any(~isfinite(relevantValues))
                continue;
            end


            % 현재 RPM이 가속도 진폭의 국부 최대인지 확인합니다.

            accelerationIsLocalMaximum = ...
                accelerationAmplitude(iRPM) > ...
                accelerationAmplitude(iRPM-1) && ...
                accelerationAmplitude(iRPM) >= ...
                accelerationAmplitude(iRPM+1);


            if ~accelerationIsLocalMaximum
                continue;
            end


            accelerationBaseline = ...
                calculateNeighbourBaseline( ...
                rpmValues, ...
                accelerationAmplitude, ...
                iRPM);


            forceBaseline = ...
                calculateNeighbourBaseline( ...
                rpmValues, ...
                forceAmplitude, ...
                iRPM);


            accelerationRatio = ...
                accelerationAmplitude(iRPM) / ...
                max(accelerationBaseline, eps);


            forceRatio = ...
                forceAmplitude(iRPM) / ...
                max(forceBaseline, eps);


            strongAccelerationCandidate = ...
                accelerationRatio >= ...
                strongAccelerationAmplification;


            accelerationAndForceCandidate = ...
                accelerationRatio >= ...
                minimumAccelerationAmplification && ...
                forceRatio >= ...
                minimumForceAmplification;


            if strongAccelerationCandidate

                detectionReason = ...
                    "가속도 강한 국부 증폭";

            elseif accelerationAndForceCandidate

                detectionReason = ...
                    "가속도와 합산반력 동시 증폭";

            else

                continue;
            end


            candidateSheet(end+1, 1) = ...
                string(summaryTable.Sheet(iRPM));


            candidateRPM(end+1, 1) = ...
                rpmValues(iRPM);


            candidateOrder(end+1, 1) = ...
                currentOrder;


            candidateFrequency(end+1, 1) = ...
                accelerationPeakFrequency(iRPM);


            candidateAccelerationAmplitude(end+1, 1) = ...
                accelerationAmplitude(iRPM);


            candidateForceAmplitude(end+1, 1) = ...
                forceAmplitude(iRPM);


            candidateAccelerationRatio(end+1, 1) = ...
                accelerationRatio;


            candidateForceRatio(end+1, 1) = ...
                forceRatio;


            candidateReason(end+1, 1) = ...
                detectionReason;
        end
    end


    candidateTable = table( ...
        candidateSheet, ...
        candidateRPM, ...
        candidateOrder, ...
        candidateFrequency, ...
        candidateAccelerationAmplitude, ...
        candidateForceAmplitude, ...
        candidateAccelerationRatio, ...
        candidateForceRatio, ...
        candidateReason, ...
        'VariableNames', { ...
        'Sheet', ...
        'TargetRPM', ...
        'HarmonicOrder', ...
        'CandidateFrequency_Hz', ...
        'AccelerationAmplitude_m_s2', ...
        'GlobalXYForceAmplitude_N', ...
        'AccelerationAmplificationRatio', ...
        'ForceAmplificationRatio', ...
        'DetectionReason'});


    if ~isempty(candidateTable)

        candidateTable = sortrows( ...
            candidateTable, ...
            {'TargetRPM', 'HarmonicOrder'});
    end
end


function baselineValue = calculateNeighbourBaseline( ...
    rpmValues, ...
    amplitudeValues, ...
    currentIndex)
% 현재 RPM 앞뒤의 진폭값을 이용하여
% 현재 RPM 위치의 선형 보간 기준값을 계산합니다.
%
% RPM 간격이 균일하지 않아도 적용할 수 있습니다.

    rpmBefore = rpmValues(currentIndex - 1);
    rpmCurrent = rpmValues(currentIndex);
    rpmAfter = rpmValues(currentIndex + 1);


    amplitudeBefore = amplitudeValues(currentIndex - 1);
    amplitudeAfter = amplitudeValues(currentIndex + 1);


    rpmInterval = rpmAfter - rpmBefore;


    if ~isfinite(rpmInterval) || rpmInterval <= 0

        baselineValue = ...
            mean([amplitudeBefore, amplitudeAfter]);

        baselineValue = max(baselineValue, eps);

        return;
    end


    interpolationRatio = ...
        (rpmCurrent - rpmBefore) / rpmInterval;


    baselineValue = ...
        amplitudeBefore + ...
        interpolationRatio * ...
        (amplitudeAfter - amplitudeBefore);


    if ~isfinite(baselineValue) || baselineValue <= 0

        baselineValue = ...
            mean([amplitudeBefore, amplitudeAfter]);
    end


    baselineValue = max(baselineValue, eps);
end


function candidateTable = createEmptyCandidateTable()
% 빈 공진 후보 테이블을 생성합니다.

    candidateTable = table( ...
        strings(0, 1), ...
        zeros(0, 1), ...
        zeros(0, 1), ...
        zeros(0, 1), ...
        zeros(0, 1), ...
        zeros(0, 1), ...
        zeros(0, 1), ...
        zeros(0, 1), ...
        strings(0, 1), ...
        'VariableNames', { ...
        'Sheet', ...
        'TargetRPM', ...
        'HarmonicOrder', ...
        'CandidateFrequency_Hz', ...
        'AccelerationAmplitude_m_s2', ...
        'GlobalXYForceAmplitude_N', ...
        'AccelerationAmplificationRatio', ...
        'ForceAmplificationRatio', ...
        'DetectionReason'});
end


function rainfallDB = normalizeRainfallToDB( ...
    rainfallAmplitude, ...
    dbFloor)
% Rainfall 진폭을 각 subplot 전체의 최대값에 대해 정규화한
% dB 값으로 변환합니다.
%
% 최대값:
%   0 dB
%
% 최소 표시값:
%   dbFloor

    maximumAmplitude = ...
        max(rainfallAmplitude(:));


    if ~isfinite(maximumAmplitude) || maximumAmplitude <= 0

        rainfallDB = ...
            dbFloor * ones(size(rainfallAmplitude));

        return;
    end


    normalizedAmplitude = ...
        rainfallAmplitude / maximumAmplitude;


    minimumLinearAmplitude = ...
        10^(dbFloor / 20);


    normalizedAmplitude = max( ...
        normalizedAmplitude, ...
        minimumLinearAmplitude);


    rainfallDB = ...
        20*log10(normalizedAmplitude);
end


function addOrderLinesToRainfall( ...
    targetAxes, ...
    rpmVector, ...
    harmonicOrders, ...
    maximumFrequency_Hz)
% Rainfall plot에 1X, 2X, 3X 차수선을 표시합니다.
%
% 주파수:
%   f_mX = m × RPM / 60

    for iOrder = 1:numel(harmonicOrders)

        currentOrder = harmonicOrders(iOrder);


        orderFrequency_Hz = ...
            currentOrder * rpmVector / 60;


        validMask = ...
            orderFrequency_Hz <= maximumFrequency_Hz;


        if nnz(validMask) < 1
            continue;
        end


        plot( ...
            targetAxes, ...
            orderFrequency_Hz(validMask), ...
            rpmVector(validMask), ...
            'w--', ...
            'LineWidth', 1.3, ...
            'HandleVisibility', 'off');


        lastValidIndex = find( ...
            validMask, ...
            1, ...
            'last');


        text( ...
            targetAxes, ...
            orderFrequency_Hz(lastValidIndex), ...
            rpmVector(lastValidIndex), ...
            sprintf(' %dX', currentOrder), ...
            'Color', 'w', ...
            'FontWeight', 'bold', ...
            'VerticalAlignment', 'bottom');
    end
end


function sheetName = makeExcelSheetName(prefix, mainText)
% Excel 시트명에서 사용할 수 없는 문자를 제거하고,
% 최대 길이 31자 제한을 적용합니다.

    sheetName = [char(prefix), char(mainText)];


    invalidCharacters = { ...
        '\', ...
        '/', ...
        '*', ...
        '?', ...
        ':', ...
        '[', ...
        ']'};


    for iCharacter = 1:numel(invalidCharacters)

        sheetName = strrep( ...
            sheetName, ...
            invalidCharacters{iCharacter}, ...
            '_');
    end


    if length(sheetName) > 31

        sheetName = sheetName(1:31);
    end
end